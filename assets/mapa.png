						}</style>		<style type="text/css" id="wp-custom-css">
			:root {
  --clube-azul-escuro: #24224C;
  --clube-azul-claro:  #C0E3EB;
  --clube-rosa:        #DD60A0;
  --clube-amarelo:     #FFD055;
  --clube-bege:        #F9F3ED;
  --clube-branco:      #FFFFFF;
}
@font-face {
  font-family: 'Montserrat Alternates';
  src: url('/wp-content/uploads/fonts/MontserratAlternates-Regular.ttf') format('truetype');
  font-weight: 400;
  font-display: swap;
}
@font-face {
  font-family: 'Montserrat Alternates';
  src: url('/wp-content/uploads/fonts/MontserratAlternates-SemiBold.ttf') format('truetype');
  font-weight: 600;
  font-display: swap;
}
@font-face {
  font-family: 'Nexa';
  src: url('/wp-content/uploads/fonts/Nexa-Regular.ttf') format('truetype');
  font-weight: 400;
  font-display: swap;
}
@font-face {
  font-family: 'Rialto Script';
  src: url('/wp-content/uploads/fonts/rialtoscript-regular.ttf') format('truetype');
  font-weight: 400;
  font-display: swap;
}
body.page-template-clube,
body.single-product.product-clube {
  font-family: 'Nexa', sans-serif;
}
body.page-template-clube h1,
body.page-template-clube h2,
body.page-template-clube h3,
body.page-template-clube .ux_text strong {
  font-family: 'Montserrat Alternates', sans-serif;
  font-weight: 600;
}
.lp-clube-button {
  background-color: var(--clube-amarelo) !important;
  color: var(--clube-azul-escuro) !important;
  border-radius: 50px !important;
  font-weight: 600 !important;
  letter-spacing: 0.01em;
  padding: 18px 36px !important;
  transition: transform 180ms ease, box-shadow 180ms ease, filter 180ms ease;
}
.lp-clube-button:hover,
.lp-clube-button:focus {
  filter: brightness(1.05);
  transform: translateY(-2px);
}
.lp-clube-button:active {
  transform: translateY(0);
  filter: brightness(0.97);
}

.lp-clube-button-secondary {
  background: transparent !important;
  color: var(--clube-azul-escuro) !important;
  text-decoration: underline !important;
  text-underline-offset: 4px;
  text-decoration-thickness: 1.5px;
  font-weight: 500 !important;
  padding: 8px 16px !important;
}
.lp-clube-button-secondary:hover {
  color: var(--clube-rosa) !important;
}

.lp-clube-button-suporte {
  background: transparent !important;
  color: var(--clube-branco) !important;
  border: 2px solid var(--clube-branco) !important;
  border-radius: 50px !important;
  font-weight: 600 !important;
  padding: 16px 32px !important;
  transition: background 180ms ease, color 180ms ease;
}
.lp-clube-button-suporte:hover,
.lp-clube-button-suporte:focus {
  background: var(--clube-branco) !important;
  color: var(--clube-azul-escuro) !important;
}

.lp-clube-jaque-instagram {
  color: var(--clube-rosa) !important;
  font-weight: 500 !important;
  padding: 4px 8px !important;
}
.lp-clube-jaque-instagram:hover { text-decoration: underline; }

.lp-clube-sec12-accordion .accordion-title {
  font-family: 'Montserrat Alternates', sans-serif !important;
  font-weight: 600;
  font-size: 1.05rem;
  color: var(--clube-azul-escuro);
  padding: 18px 20px !important;
  border-radius: 12px;
  background: var(--clube-branco);
  margin-bottom: 8px;
  transition: background 180ms ease;
}
.lp-clube-sec12-accordion .accordion-title:hover { background: #fff8ee; }
.lp-clube-sec12-accordion .accordion-title.active {
  background: var(--clube-amarelo);
}
.lp-clube-sec12-accordion .accordion-inner {
  padding: 18px 22px !important;
  font-family: 'Nexa', sans-serif;
  color: var(--clube-azul-escuro);
  line-height: 1.6;
}

section[class*="DORES"] .featured-box .featured-img img {
  filter: drop-shadow(0 2px 6px rgba(36, 34, 76, 0.08));
}

section[class*="OFERTA-"] .col-inner del,
section[class*="OFERTA-"] .col-inner s {
  color: rgba(36, 34, 76, 0.5);
  font-size: 0.95em;
}

section .ux-image, .ux_text img, .ux_image img, .featured-img img {
  height: auto;
  max-width: 100%;
}
.lp-sec1-bann { min-height: 280px; }

@media (max-width: 549px) {
  .lp-clube-button       { padding: 16px 24px !important; font-size: 0.95rem; }
  .lp-clube-button-suporte { padding: 14px 22px !important; font-size: 0.95rem; }
  section[class*="DORES"] .col[class*="span-2"] { flex-basis: 50% !important; }
}
@media (min-width: 550px) and (max-width: 849px) {
}
		</style>
