<style id="custom-css" type="text/css">:root {--primary-color: #dd60a0;--fs-color-primary: #dd60a0;--fs-color-secondary: #00c64c;--fs-color-success: #627D47;--fs-color-alert: #ffd055;--fs-color-base: #4a4a4a;--fs-experimental-link-color: #dd60a0;--fs-experimental-link-color-hover: #24224c;}.tooltipster-base {--tooltip-color: #fff;--tooltip-bg-color: #24224c;}.off-canvas-right .mfp-content, .off-canvas-left .mfp-content {--drawer-width: 300px;}.off-canvas .mfp-content.off-canvas-cart {--drawer-width: 360px;}.container-width, .full-width .ubermenu-nav, .container, .row{max-width: 1250px}.row.row-collapse{max-width: 1220px}.row.row-small{max-width: 1242.5px}.row.row-large{max-width: 1280px}.sticky-add-to-cart--active, #wrapper,#main,#main.dark{background-color: #f4f4f4}.header-main{height: 90px}#logo img{max-height: 90px}#logo{width:150px;}.header-bottom{min-height: 55px}.header-top{min-height: 30px}.transparent .header-main{height: 90px}.transparent #logo img{max-height: 90px}.has-transparent + .page-title:first-of-type,.has-transparent + #main > .page-title,.has-transparent + #main > div > .page-title,.has-transparent + #main .page-header-wrapper:first-of-type .page-title{padding-top: 120px;}.header.show-on-scroll,.stuck .header-main{height:70px!important}.stuck #logo img{max-height: 70px!important}.search-form{ width: 97%;}.header-bg-color {background-color: #ffffff}.header-bottom {background-color: #ffffff}.top-bar-nav > li > a{line-height: 16px }.header-main .nav > li > a{line-height: 16px }.stuck .header-main .nav > li > a{line-height: 50px }.header-bottom-nav > li > a{line-height: 16px }@media (max-width: 549px) {.header-main{height: 70px}#logo img{max-height: 70px}}.main-menu-overlay{background-color: #ddb1b1}.nav-dropdown{border-radius:15px}.nav-dropdown{font-size:100%}.header-top{background-color:#24224c!important;}body{font-size: 100%;}body{font-family: nexa-regular, sans-serif;}body {font-weight: 400;font-style: normal;}.nav > li > a {font-family: nexa-regular, sans-serif;}.mobile-sidebar-levels-2 .nav > li > ul > li > a {font-family: nexa-regular, sans-serif;}.nav > li > a,.mobile-sidebar-levels-2 .nav > li > ul > li > a {font-weight: 700;font-style: normal;}h1,h2,h3,h4,h5,h6,.heading-font, .off-canvas-center .nav-sidebar.nav-vertical > li > a{font-family: nexa-regular, sans-serif;}h1,h2,h3,h4,h5,h6,.heading-font,.banner h1,.banner h2 {font-weight: 700;font-style: normal;}.alt-font{font-family: rialto-script-regula, sans-serif;}.alt-font {font-weight: 400!important;font-style: normal!important;}.star-rating span:before,.star-rating:before, .woocommerce-page .star-rating:before, .stars a:hover:after, .stars a.active:after{color: #ffd055}input[type='submit'], input[type="button"], button:not(.icon), .button:not(.icon){border-radius: 20px!important}@media screen and (min-width: 550px){.products .box-vertical .box-image{min-width: 300px!important;width: 300px!important;}}.footer-1{background-color: #f9f3ed}.footer-2{background-color: #fff6f9}.absolute-footer, html{background-color: #f9f3ed}button[name='update_cart'] { display: none; }.nav-vertical-fly-out > li + li {border-top-width: 1px; border-top-style: solid;}/* Custom CSS */.material-icons, material-icons-outlined, .material-icons-round { font-size: inherit; }.text .material-icons-outlined span{position:relative;top:2px;margin-right:5px;}.box-text.text-center{background: white !important;}.yith-wcmbs-download-button.unlocked{min-height:5px !important;height:50px !important;width:100% !important;background: #00c64c;text-align: center;line-height: 2.0;font-size: 16px !important;}.yith-wcmbs-download-button.unlocked:hover{background: #459b4a;}/*li.wc_payment_method::marker {color: transparent;}*/#wp-comment-cookies-consent{display:none;}.coupon {display:none;}.woocommerce-form-coupon-toggle{display:none;}.lightbox-content {background-color: #fff;box-shadow: 3px 3px 20px 0 rgba(0,0,0,.15);margin: 0 auto;max-width: 875px;position: relative;padding: 50px 100px;border-radius: 20px;}li.html.custom.html_top_right_text{display:none;}/* Oculta ordenação por valor no catálogo*/select[name="orderby"] option[value="menu_order"],select[name="orderby"] option[value="price"],select[name="orderby"] option[value="price-desc"] {display: none;}/* Remove "Total" do checkout.order-total {display: none;}*//* Remove Yith Assinatura Total R$ / 365 dias */.ywsbs-recurring-totals-items {display: none;}/******* Clube *******/.clube-bann .banner-bg :is(img,picture,video) {object-fit: contain;}/******* Clube *******//*******Flatsome Cookies/Popup*******/.flatsome-cookies {width: fit-content;border-radius: 10px;margin: auto;right: 0;left: 0;font-size: 90%;}.flatsome-cookies__buttons>a {margin-right: 0px;}/*******Flatsome Cookies/Popup*******//******* Clube LP v02 *******/.lp-clube-sec1-bann .banner-bg :is(img,picture,video) {object-fit: contain;object-position: right;right: 5%;left: auto;}.lp-clube-section2-colum3 {z-index: -1;}.button.lp-clube-button {border-radius: 50px !important;font-family: 'monts-alter-semibold', sans-serif !important;color: #24224c;font-size: 1.5em;display: inline-flex;align-items: center;justify-content: center;padding: 20px 40px;}.button.lp-clube-button-suporte {border-radius: 50px !important;font-family: 'Nexa-regular', sans-serif !important;color: #24224c;font-size: 1.5em;display: inline-flex;align-items: center;justify-content: center;}.button.lp-clube-button span {margin: 0px;line-height: 1;}.lp-clube-sec4-r1c2-banner-text-box .is-border {border-radius: 0 25px 25px 0;}.lp-clube-sec4-r1c2-banner-text-box .text-box-content {border-radius: 0 25px 25px 0;}.icon-box-left.lp-clube-sec5-r1c1-r1c2-txtbx {align-items: center;}.lp-clube-sec5-r1c1-r1c2-img {position: relative;right: -10vw;}.lp-clube-sec10-r1c1-ban-bg-img .banner-bg :is(img,picture,video) {height: 80%;position: absolute;bottom: 0;top: auto;width: 100%;object-fit: scale-down;object-position: right;}.lp-clube-sec10-r1c1-ban-bg-img .banner-layers {background:linear-gradient(to