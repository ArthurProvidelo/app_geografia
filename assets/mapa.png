on.lp-links-btn span, .button.lp-links-btn-EDDP span {line-height: 1.1em;}/***** LP Links *****//***** Clube Catalogo *****//***** Oculta preço da pesquisa *****/.search-price {display: none;}/***** Clube Catalogo *****//******* Clube LP v03 *******/.lp-sec1-bann .banner-layers {z-index: 1; background:linear-gradient(to top, #F9F3ED 0%, transparent 50%),linear-gradient(to right, #F9F3ED 0%, transparent 30%),linear-gradient(to left, #F9F3ED 0%, transparent 30%);}.section.lp-section4 {z-index: 1; background:linear-gradient(to bottom, #F9F3ED 0%, transparent 50%);}.col.lp-section1-col1 {align-self: end;}/******* Clube LP v03 *******//* Custom CSS Tablet */@media (max-width: 849px){/******* Clube LP *******/.lp-clube-sec1-bann .banner-bg :is(img,picture,video) {object-fit: cover;object-position: 50% 30%;right: auto;}.lp-clube-sec1-bann .banner-layers{background:linear-gradient(to top, #24224C 25%, transparent 80%),linear-gradient(to left, #24224C 0%, transparent 5%),linear-gradient(to right, #24224C 0%, transparent 5%);}.lp-clube-sec10-r1c1-ban-bg-img .banner-bg :is(img,picture,video) {height: 70%;}/******* Clube LP *******//******* Clube *******/.clube-bann .banner-bg :is(img,picture,video) {object-fit: cover;}/******* Clube *******//******* Clube Especial dia dos Profs - EDDP *******/.lp-EDDP-cadastro-bann .banner-layers {background:linear-gradient(to top, #24224C 0%, transparent 40%);}.lp-EDDP-cadastro-bann .banner-bg :is(img,picture,video) {object-position: 50% 30%;}.button.lp-EDDP-button-aulas {font-size: 1em;}/******* Clube Especial dia dos Profs - EDDP *******//***** LP Links *****/.lp-links-sec .section-bg :is(img,picture,video) {object-fit: cover;}.button.lp-links-btn {font-size: 2em;min-height: 2.5em;}.button.lp-links-btn-Evento {font-size: 1.8em; min-height: 2.6em;}.lp-links-btn-Evento span {line-height: 1.2em;}/***** LP Links *****//******* Clube LP v03 *******/.lp-sec1-bann .banner-layers {z-index: 1; background: linear-gradient(to top, #F9F3ED 10%, transparent 60%);}/******* Clube LP v03 *******/}/* Custom CSS Mobile */@media (max-width: 549px){/******* Clube LP *******/.button.lp-clube-button {font-size: 1.2em;padding: 10px 40px;}.button.lp-clube-button-suporte {padding: 0px 20px;}.lp-clube-sec5-r1c1-r1c2-img {right: -25vw;}.lp-clube-sec10-r1c1-ban-bg-img .banner-bg :is(img,picture,video) {height: 60%;}/******* Clube LP *******//***** LP Links *****/.button.lp-links-btn {min-height: 2em;font-size: 2em;}.button.lp-links-btn-Evento {font-size: 1.5em;min-height: 2.6em;}.lp-links-btn-Evento span {line-height: 1em;}/***** LP Links *****/}.label-new.menu-item > a:after{content:"Novo";}.label-hot.menu-item > a:after{content:"Quente";}.label-sale.menu-item > a:after{content:"Promoção";}.label-popular.menu-item > a:after{content:"Popular";}</style><style type="text/css">.woocommerce-cart-form .product-price, .woocommerce-cart-form .product-subtotal{ display: none; }.product .single_add_to_cart_button, .product .add_to_cart_button {
